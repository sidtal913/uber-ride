# JWT verification (align with Cognito JWKS in production — see spec/auth.yaml)
JWT_SECRET=dev-only-change-me-use-cognito-in-prod
JWT_ISSUER=uber-ride-api
JWT_AUDIENCE=uber-ride-clients

# PostgreSQL (Montreal ride persistence). When unset, API uses in-memory store for local dev.
DATABASE_URL=postgresql://uber_ride:uber_ride@localhost:5432/uber_ride

# Optional: run SQL in lib/db/schema.sql against this database on first deploy
PGSSLMODE=prefer
